# Violoop TL V4 kernel configuration and final board policy.

# USB gadget: HID, CDC ACM and FunctionFS.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_PHY_ROCKCHIP_USBDP=y

# FocalTech FT3519 touchscreen on the FPT TTCM03921235 module.
# The RK DSI2 loader-logo handoff calls panel_simple_loader_protect(), so keep
# the validated panel-simple path while all panel data remains V4-local.
CONFIG_DRM_PANEL_SIMPLE=y
# CONFIG_DRM_PANEL_FPT_TTCM03921235 is not set
CONFIG_ROCKCHIP_PANEL_NOTIFIER=y
CONFIG_TOUCHSCREEN_FT3519=y
# CONFIG_TOUCHSCREEN_SW42000 is not set
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# LT7911EXC Type-C/DP to CSI3 bridge.
CONFIG_VIDEO_LT7911EXC=y

# KM8V7001JM-B810 uses the RK3576 UFS host (UFS 2.1, two lanes).
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_ROCKCHIP=y

# SAI1 uses the normal DMA PCM path; software digital loopback is disabled.
# CONFIG_SND_SOC_ROCKCHIP_DLP_PCM is not set

# TL V4 is populated with ES8390. ES8390 uses the upstream ES8389 driver.
CONFIG_SND_SOC_ES8389=y

# Keep the product ALSA contract deterministic: the built-in ES8390
# multicodec card registers first as card0; load the PDM simple-card after
# userspace starts so it becomes card1.  The existing product application
# expects playback on hw:0,0 and PDM capture on plughw:1,0.
CONFIG_SND_SIMPLE_CARD=m

# PWM1_CH5_M1 is owned directly by violoop-thermald through PWM sysfs.
# CONFIG_SENSORS_PWM_FAN is not set

# RK1828 is attached to the TL V4 PCIe0 root complex. The endpoint function
# driver is built from the versioned standalone RK182x source in the TL V4
# rootfs component, so the shared in-kernel demo driver stays disabled.
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_DW_ROCKCHIP=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# Keep the complete RK3576 host-side support set used by the validated
# PCIe1 baseline.  These also support the TL V4 thermal/devfreq policy.
CONFIG_ROCKCHIP_IPA=y
CONFIG_ROCKCHIP_OPP=y
CONFIG_ROCKCHIP_SYSTEM_MONITOR=y
# CONFIG_PCIE_DW_DMATEST is not set
# CONFIG_PCIE_DW_ROCKCHIP_EP is not set
# CONFIG_PCIE_FUNC_RKEP is not set
