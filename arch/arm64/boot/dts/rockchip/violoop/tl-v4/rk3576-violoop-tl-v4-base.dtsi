&rockchip_suspend {
	status = "okay";
	rockchip,sleep-debug-en = <1>;

	rockchip,sleep-io-ret-config = <
		(0
		| RKPM_VCCIO3_RET_EN
		)
	>;

	rockchip,regulator-on-before-mem = <&vdd_npu_s0>;
};

&route_dsi {
	status = "okay";
};

&vp1 {
	/* Keep VOP scan native; panel DCS scan rotation remains disabled. */
};

&sai6 {
	status = "okay";
